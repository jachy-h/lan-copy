{
  "name": "lan-copy-frontend",
  "private": true,
  "version": "0.5.8",
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "scripts": {
    "dev": "node scripts/vendor-assets.mjs && vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "build": "node scripts/vendor-assets.mjs && vite build",
    "sync-assets": "node scripts/vendor-assets.mjs && node scripts/sync-assets.mjs",
    "check-assets": "node scripts/vendor-assets.mjs && node scripts/sync-assets.mjs --check",
    "check": "npm run typecheck && npm test && npm run build",
    "check-vendor": "node scripts/vendor-assets.mjs && node scripts/sync-assets.mjs --check-vendor",
    "test:browser": "node scripts/browser-test.mjs"
  },
  "dependencies": {
    "docx-preview": "0.4.1",
    "jszip": "3.10.2",
    "pdfjs-dist": "6.4.299",
    "vue": "3.5.44",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/test-utils": "2.4.6",
    "jsdom": "26.1.0",
    "playwright": "1.58.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "vue-tsc": "3.1.1"
  }
}
